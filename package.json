{
  "name": "code-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:content": "node scripts/validate-content.mjs",
    "check": "npm run lint && npm run test && npm run check:content && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
